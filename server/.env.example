# PostgreSQL Database Connection String (e.g. from Neon PostgreSQL or self-hosted)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=

# Environment Mode: development | production | test
NODE_ENV=production

# Server Listening Port (Render automatically sets this in production)
PORT=4000

# Allowed Frontend Client URL(s) for CORS & CSRF origin validation
# Supports comma-separated list of origins (e.g., https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Cookie SameSite Attribute: lax | strict | none
# Use "none" for cross-domain production deployments (e.g., Vercel frontend + Render backend)
# Use "lax" for local development or same-domain proxy setups
COOKIE_SAMESITE=lax

# Session Time-to-Live in Hours (default: 12)
SESSION_TTL_HOURS=12

# Database Pool Max Connections (default: 35)
DB_POOL_MAX=35
